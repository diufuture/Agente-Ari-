# ─── Obligatorio ────────────────────────────────────────────────────
# Clave de la API de Anthropic. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Acceso con contraseña ──────────────────────────────────────────
# Si defines ARI_CLAVE, la aplicación pide usuario y contraseña para entrar.
# Sin ella queda abierta: cómodo en tu propio computador, PELIGROSO en un
# servidor público, donde cualquiera vería tus clientes y tus cobros.
#
#   En tu computador  -> puedes dejarlas vacías
#   En un servidor    -> son obligatorias
#
# ARI_USUARIO=admin
# ARI_CLAVE=una-contraseña-larga-y-difícil

# ─── Agendamientos que llegan de la web ─────────────────────────────
# Para que el formulario de entregas de la web avise a Ari y la cita aparezca
# sola en la agenda. Inventa una clave larga y pega la MISMA en el Apps Script
# de la hoja de Google (ver el README). Sin esta variable, la puerta queda
# cerrada y nadie puede escribir en la agenda desde afuera.
#
# ARI_TOKEN_ENLACE=una-clave-larga-e-inventada-de-al-menos-16-caracteres

# ─── Opcional ───────────────────────────────────────────────────────
# Modelo a usar. Por defecto claude-sonnet-5.
# Para bajar el costo por consulta:
#   claude-haiku-4-5   -> el más económico y rápido ($1 / $5 por millón)
#   claude-opus-5      -> el más capaz, si hiciera falta más razonamiento
ARI_MODEL=claude-sonnet-5

# Puerto del servidor (en cPanel lo asigna el hosting: no lo definas)
PORT=3000

# Ruta del archivo SQLite. Relativa a la carpeta del proyecto, o absoluta.
ARI_DB=./data/clic-control.db

# Días que dura la sesión antes de volver a pedir la contraseña
# ARI_DIAS_SESION=30
