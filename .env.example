# Clave de la API de Anthropic (obligatoria)
# Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Por defecto claude-opus-5.
# Si quieres bajar el costo por consulta, cambia a:
#   claude-haiku-4-5   -> el más económico y rápido ($1 / $5 por millón de tokens)
#   claude-sonnet-5    -> intermedio
# La arquitectura ya está optimizada para gastar pocos tokens en cualquier modelo.
ARI_MODEL=claude-opus-5

# Puerto del servidor
PORT=3000

# Ruta del archivo de base de datos SQLite
ARI_DB=./data/clic-control.db
